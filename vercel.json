{
  "rewrites": [
    {
      "source": "/",
      "destination": "/residential.html"
    },
    {
      "source": "/setup",
      "destination": "/setup.html"
    },
    {
      "source": "/admin",
      "destination": "/setup"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/support/:slug",
      "destination": "/residential.html?org=:slug"
    }
  ]
}
